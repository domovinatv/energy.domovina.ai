{
  "name": "domovina-energy",
  "version": "0.1.0",
  "private": true,
  "description": "domovina.energy — registar i zajedničko financiranje sunčanih elektrana u Hrvatskoj. Live: energy.domovina.ai (closed beta).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev -p 3020",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "lint:copy": "tsx scripts/check-copy.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run lint && npm run lint:copy && npm run typecheck && npm run test && npm run build",
    "deploy": "npm run verify && npm run check:beta && wrangler deploy",
    "check:beta": "tsx scripts/check-beta-rail.mts"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.6",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "maplibre-gl": "^6.9.1",
    "mermaid": "^11.17.2",
    "next": "^16.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.146.0"
  }
}
